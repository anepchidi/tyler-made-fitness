# Backend Environment Variables - Copy to .env and fill in your values

# Database URL - Use SQLite for local development
# For production: postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./workout.db

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS - Allowed origins for frontend requests
# For development: http://localhost:5173
# For production: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173

# File Upload Configuration
UPLOAD_DIR=static/exercises
MAX_UPLOAD_SIZE_MB=5

# Optional: Email configuration (for future features)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
